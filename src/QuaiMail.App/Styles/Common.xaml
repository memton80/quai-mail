<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tous les styles de l'application sont ici : les vues n'ont pas de mise en forme en ligne répétée
        (repris de Quai PDF, sans ce qui était propre au PDF).
    -->

    <!-- Barre de titre personnalisée. -->
    <Style x:Key="TitleBarPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="TitleBarIconStyle" TargetType="Image">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <Style
        x:Key="TitleBarTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Bandeau « nouvelle version disponible », sous la barre de titre. -->
    <Style x:Key="UpdateInfoBarStyle" TargetType="InfoBar">
        <Setter Property="Margin" Value="12,0,12,8" />
        <Setter Property="IsClosable" Value="True" />
    </Style>

    <Style x:Key="UpdateProgressStyle" TargetType="ProgressBar">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--
        Trois volets : comptes et dossiers (posé sur le Mica, à gauche), liste des mails et lecture (surface détachée du
        Mica, coin supérieur gauche arrondi, comme le contenu d'une page Windows 11).
    -->
    <Style x:Key="FolderPaneStyle" TargetType="Grid">
        <Setter Property="Width" Value="248" />
        <Setter Property="Padding" Value="12,0,12,12" />
        <Setter Property="RowSpacing" Value="8" />
    </Style>

    <Style x:Key="ContentSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="CornerRadius" Value="8,0,0,0" />
    </Style>

    <Style x:Key="MessageListPaneStyle" TargetType="Grid">
        <Setter Property="Width" Value="340" />
        <Setter Property="RowSpacing" Value="8" />
    </Style>

    <Style x:Key="ReaderPaneStyle" TargetType="Grid">
        <Setter Property="RowSpacing" Value="8" />
    </Style>

    <!-- Trait vertical entre la liste et la lecture. -->
    <Style x:Key="PaneDividerStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style
        x:Key="PaneHeaderStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="4,8,4,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style
        x:Key="SurfaceHeaderStyle"
        BasedOn="{StaticResource PaneHeaderStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="16,12,16,0" />
    </Style>

    <!-- Bouton en bas du volet de gauche (réglages) : arrondi de Windows 11, icône puis texte. -->
    <Style
        x:Key="PaneButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="ButtonContentStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="10" />
    </Style>

    <Style x:Key="ButtonIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
    </Style>


    <!-- Volet des comptes et dossiers. -->
    <Style
        x:Key="PaneIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="PaneInfoBarStyle" TargetType="InfoBar">
        <Setter Property="IsClosable" Value="False" />
    </Style>

    <Style x:Key="NavListStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Margin" Value="-12,0,-12,0" />
    </Style>

    <Style x:Key="NavItemStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="NavIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Flèche d'un compte (replié / déplié), à la place de l'icône et de la même largeur que celles des dossiers. -->
    <Style x:Key="NavChevronStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="NavTextStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style
        x:Key="UnreadCountStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PaneButtonsStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <!-- Liste des mails. -->
    <Style x:Key="SearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="Margin" Value="12,12,12,0" />
    </Style>

    <Style x:Key="SearchServerLinkStyle" TargetType="HyperlinkButton">
        <Setter Property="Margin" Value="0,8,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ListBusyBarStyle" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <Style x:Key="ListInfoBarStyle" TargetType="InfoBar">
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="IsClosable" Value="False" />
    </Style>

    <Style x:Key="MessageListStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Padding" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MessageItemStyle" TargetType="Grid">
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="RowSpacing" Value="2" />
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style
        x:Key="MessageSenderStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MessageMetaStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
    </Style>

    <Style x:Key="FlagIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="MessageDateStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="MessageSubjectStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style
        x:Key="LoadMoreButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- Ajout d'un compte. -->
    <Style x:Key="DialogScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="0,0,16,0" />
    </Style>

    <Style x:Key="DialogExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style
        x:Key="DialogSectionStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock" />

    <Style x:Key="ServerRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="PortBoxStyle" TargetType="NumberBox">
        <Setter Property="Width" Value="96" />
        <Setter Property="Minimum" Value="1" />
        <Setter Property="Maximum" Value="65535" />
        <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
    </Style>

    <Style x:Key="SecurityBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="132" />
    </Style>

    <Style x:Key="BusyBarStyle" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
    </Style>


    <!-- Volet de lecture. -->
    <Style x:Key="ReaderHeaderStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,4,12,8" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="ReaderHeaderTextStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="2" />
    </Style>

    <Style
        x:Key="ReaderSubjectStyle"
        BasedOn="{StaticResource SubtitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style
        x:Key="ReaderFromStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style
        x:Key="ReaderMetaStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="ReaderActionsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style
        x:Key="ReaderActionButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AttachmentsScrollerStyle" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="16,0,16,8" />
        <Setter Property="HorizontalScrollMode" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollMode" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style
        x:Key="AttachmentButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style
        x:Key="AttachmentNameStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="220" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="AttachmentSizeStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ReaderBodyStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>


    <!-- Rédaction d'un message (posée sur le volet de lecture, fond opaque). -->
    <Style
        x:Key="NewMessageButtonStyle"
        BasedOn="{StaticResource AccentButtonStyle}"
        TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="ComposerStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="Padding" Value="16,12,12,12" />
        <Setter Property="RowSpacing" Value="10" />
    </Style>

    <Style
        x:Key="ComposerSendButtonStyle"
        BasedOn="{StaticResource AccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style
        x:Key="ComposerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style
        x:Key="ComposerStatusStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ComposerFieldsStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style x:Key="ComposerFromStyle" TargetType="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style
        x:Key="ComposerCopiesToggleStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Height" Value="32" />
    </Style>

    <Style x:Key="ComposerBodyStyle" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsSpellCheckEnabled" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MinHeight" Value="160" />
    </Style>

    <Style x:Key="SmallIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- Brouillon en cours, dans le volet de lecture. -->
    <Style x:Key="DraftCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="16,0,16,16" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="DraftCardPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style
        x:Key="DraftCardLabelStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="DraftCardTitleStyle"
        BasedOn="{StaticResource SubtitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- État vide centré (icône, titre, explication). -->
    <Style x:Key="EmptyStatePanelStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="EmptyStateIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="EmptyStateTitleStyle"
        BasedOn="{StaticResource SubtitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="EmptyStateHintStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Formulaires des boîtes de dialogue. -->
    <Style x:Key="DialogFormStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="MinWidth" Value="360" />
    </Style>

    <Style
        x:Key="DialogHintStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style
        x:Key="DialogBodyStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Rédaction : bouton Signer (OpenPGP). -->
    <Style
        x:Key="ComposerToggleStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- Réglages : signature des mails (OpenPGP). -->
    <Style x:Key="TrustedRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="Padding" Value="12,4,4,4" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style
        x:Key="TrustedNameStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="PgpSectionStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="PgpKeyRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style
        x:Key="PgpKeyNameStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style
        x:Key="PgpFingerprintStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PgpButtonsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="PgpConfirmStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- Ajout de compte : connexion par le navigateur (Gmail, Outlook.com). -->
    <Style x:Key="SignInPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style
        x:Key="SignInButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
