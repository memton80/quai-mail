<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuaiMail.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:QuaiMail.App.Localization"
    xmlns:ui="using:QuaiMail.App"
    xmlns:views="using:QuaiMail.App.Views"
    xmlns:vm="using:QuaiMail.Core.ViewModels">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Invoked="OnSearchAccelerator" Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (zone de glissement de la fenêtre). -->
        <Grid x:Name="AppTitleBar" Height="48">
            <StackPanel Style="{StaticResource TitleBarPanelStyle}">
                <Image Source="ms-appx:///Assets/AppIcon.png" Style="{StaticResource TitleBarIconStyle}" />
                <TextBlock Style="{StaticResource TitleBarTextStyle}" Text="{l:Str Key=App_Title}" />
            </StackPanel>
        </Grid>

        <!--
            Nouvelle version publiée sur GitHub (repris de Quai) : téléchargement, vérification, installation et
            redémarrage. Fermé, le bandeau est retiré de la mise en page.
        -->
        <StackPanel Grid.Row="1">
            <InfoBar
                IsOpen="{x:Bind Updates.IsOpen, Mode=TwoWay}"
                Message="{x:Bind Updates.Message, Mode=OneWay}"
                Severity="{x:Bind ui:UiHelpers.WarningIf(Updates.HasFailed), Mode=OneWay}"
                Style="{StaticResource UpdateInfoBarStyle}"
                Title="{l:Str Key=Update_Title}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Updates.IsOpen), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Click="OnUpdateActionClick"
                        Content="{x:Bind Updates.ActionText, Mode=OneWay}"
                        IsEnabled="{x:Bind Updates.IsActionEnabled, Mode=OneWay}" />
                </InfoBar.ActionButton>
                <ProgressBar
                    AutomationProperties.Name="{l:Str Key=Update_ProgressName}"
                    Maximum="100"
                    Style="{StaticResource UpdateProgressStyle}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(Updates.IsDownloading), Mode=OneWay}"
                    Value="{x:Bind Updates.Progress, Mode=OneWay}" />
            </InfoBar>

            <!-- Mail envoyé (seul le bouton Envoyer y mène). -->
            <InfoBar
                IsOpen="{x:Bind Composer.ShowSent, Mode=TwoWay}"
                Message="{x:Bind Composer.SentMessage, Mode=OneWay}"
                Severity="Success"
                Style="{StaticResource UpdateInfoBarStyle}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Composer.ShowSent), Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Volet 1 : comptes et dossiers. -->
            <Grid AutomationProperties.Name="{l:Str Key=Pane_Accounts}" Style="{StaticResource FolderPaneStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    AutomationProperties.Name="{l:Str Key=Toolbar_NewMessage}"
                    Click="OnNewMessageClick"
                    IsEnabled="{x:Bind Mailbox.HasAccounts, Mode=OneWay}"
                    Style="{StaticResource NewMessageButtonStyle}"
                    ToolTipService.ToolTip="{l:Str Key=Toolbar_NewMessageTooltip}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Style="{StaticResource ButtonContentStyle}">
                        <FontIcon Glyph="&#xE710;" Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock Text="{l:Str Key=Toolbar_NewMessage}" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource PaneHeaderStyle}" Text="{l:Str Key=Pane_Accounts}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="{l:Str Key=Mailbox_Refresh}"
                        Command="{x:Bind Mailbox.RefreshCommand}"
                        Style="{StaticResource PaneIconButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Mailbox_RefreshTooltip}"
                        Visibility="{x:Bind ui:UiHelpers.VisibleIf(Mailbox.HasAccounts), Mode=OneWay}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonIconStyle}" />
                    </Button>
                </Grid>

                <InfoBar
                    Grid.Row="2"
                    IsOpen="{x:Bind Mailbox.HasError, Mode=OneWay}"
                    Message="{x:Bind Mailbox.ErrorMessage, Mode=OneWay}"
                    Severity="Warning"
                    Style="{StaticResource PaneInfoBarStyle}" />

                <ListView
                    x:Name="NavList"
                    Grid.Row="3"
                    AutomationProperties.Name="{l:Str Key=Pane_Accounts}"
                    ItemsSource="{x:Bind Mailbox.Items}"
                    SelectedItem="{x:Bind Mailbox.SelectedItem, Mode=OneWay}"
                    SelectionChanged="OnNavSelectionChanged"
                    Style="{StaticResource NavListStyle}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(Mailbox.HasAccounts), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItemViewModel">
                            <Grid
                                AutomationProperties.Name="{x:Bind Title}"
                                Margin="{x:Bind ui:UiHelpers.Indent(Depth, IsAccount)}"
                                Style="{StaticResource NavItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnRemoveAccountClick" Text="{l:Str Key=Mailbox_RemoveAccount}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <FontIcon Glyph="{x:Bind ui:UiHelpers.FolderGlyph(Role, IsAccount)}" Style="{StaticResource NavIconStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontWeight="{x:Bind ui:UiHelpers.StrongIf(IsAccount)}"
                                    Style="{StaticResource NavTextStyle}"
                                    Text="{x:Bind Title}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource UnreadCountStyle}"
                                    Text="{x:Bind Unread, Mode=OneWay}"
                                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(HasUnread), Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="3"
                    Style="{StaticResource EmptyStatePanelStyle}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(Mailbox.HasNoAccount), Mode=OneWay}">
                    <FontIcon Glyph="&#xE716;" Style="{StaticResource EmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="{l:Str Key=Pane_NoAccountTitle}" />
                    <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="{l:Str Key=Pane_NoAccountHint}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Style="{StaticResource PaneButtonsStyle}">
                    <Button
                        AutomationProperties.Name="{l:Str Key=Toolbar_AddAccount}"
                        Click="OnAddAccountClick"
                        Style="{StaticResource PaneButtonStyle}">
                        <StackPanel Style="{StaticResource ButtonContentStyle}">
                            <FontIcon Glyph="&#xE710;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="{l:Str Key=Toolbar_AddAccount}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        AutomationProperties.Name="{l:Str Key=Toolbar_Settings}"
                        Click="OnSettingsClick"
                        Style="{StaticResource PaneButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Toolbar_SettingsTooltip}">
                        <StackPanel Style="{StaticResource ButtonContentStyle}">
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="{l:Str Key=Toolbar_Settings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Volets 2 et 3 : liste des mails et lecture, sur une même surface. -->
            <Border Grid.Column="1" Style="{StaticResource ContentSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid AutomationProperties.Name="{l:Str Key=Pane_Messages}" Style="{StaticResource MessageListPaneStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Recherche plein texte (cache, sans connexion), puis éventuellement sur le serveur. -->
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            AutomationProperties.Name="{l:Str Key=Search_Placeholder}"
                            PlaceholderText="{l:Str Key=Search_Placeholder}"
                            QueryIcon="Find"
                            QuerySubmitted="OnSearchSubmitted"
                            Style="{StaticResource SearchBoxStyle}"
                            TextChanged="OnSearchTextChanged" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SurfaceHeaderStyle}" Text="{x:Bind Messages.Title, Mode=OneWay}" />
                            <HyperlinkButton
                                Grid.Column="1"
                                Command="{x:Bind Messages.SearchServerCommand}"
                                Content="{l:Str Key=Search_Server}"
                                Style="{StaticResource SearchServerLinkStyle}"
                                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.CanSearchServer), Mode=OneWay}" />
                        </Grid>
                        <ProgressBar
                            Grid.Row="2"
                            AutomationProperties.Name="{l:Str Key=Messages_Loading}"
                            Style="{StaticResource ListBusyBarStyle}"
                            Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.IsLoading), Mode=OneWay}" />
                        <InfoBar
                            Grid.Row="3"
                            IsOpen="{x:Bind Messages.HasError, Mode=OneWay}"
                            Message="{x:Bind Messages.ErrorMessage, Mode=OneWay}"
                            Severity="Warning"
                            Style="{StaticResource ListInfoBarStyle}" />

                        <ListView
                            x:Name="MessageList"
                            Grid.Row="4"
                            AutomationProperties.Name="{l:Str Key=Pane_Messages}"
                            ItemsSource="{x:Bind Messages.Messages}"
                            SelectedItem="{x:Bind Messages.SelectedMessage, Mode=OneWay}"
                            SelectionChanged="OnMessageSelectionChanged"
                            Style="{StaticResource MessageListStyle}">
                            <ListView.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
                            </ListView.KeyboardAccelerators>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageItemViewModel">
                                    <Grid AutomationProperties.Name="{x:Bind ui:UiHelpers.MessageName(Sender, Subject, DateText, IsRead), Mode=OneWay}" Style="{StaticResource MessageItemStyle}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout Opening="OnMessageMenuOpening">
                                                <MenuFlyoutSubItem Text="{l:Str Key=Messages_MoveTo}">
                                                    <MenuFlyoutSubItem.Icon>
                                                        <FontIcon Glyph="&#xE8DE;" />
                                                    </MenuFlyoutSubItem.Icon>
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutItem Click="OnDeleteMessageClick" Text="{l:Str Key=Messages_Delete}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontWeight="{x:Bind ui:UiHelpers.StrongIfUnread(IsRead), Mode=OneWay}"
                                            Style="{StaticResource MessageSenderStyle}"
                                            Text="{x:Bind Sender}" />
                                        <StackPanel Grid.Column="1" Style="{StaticResource MessageMetaStyle}">
                                            <FontIcon
                                                Glyph="&#xE734;"
                                                Style="{StaticResource FlagIconStyle}"
                                                Visibility="{x:Bind ui:UiHelpers.VisibleIf(IsFlagged), Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource MessageDateStyle}" Text="{x:Bind DateText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            FontWeight="{x:Bind ui:UiHelpers.StrongIfUnread(IsRead), Mode=OneWay}"
                                            Style="{StaticResource MessageSubjectStyle}"
                                            Text="{x:Bind Subject}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.Footer>
                                <Button
                                    Command="{x:Bind Messages.LoadMoreCommand}"
                                    Content="{l:Str Key=Messages_LoadMore}"
                                    Style="{StaticResource LoadMoreButtonStyle}"
                                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.HasMore), Mode=OneWay}" />
                            </ListView.Footer>
                        </ListView>

                        <StackPanel
                            Grid.Row="4"
                            Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Messages.HasFolder), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8C3;" Style="{StaticResource EmptyStateIconStyle}" />
                            <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="{l:Str Key=Pane_NoFolderTitle}" />
                            <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="{l:Str Key=Pane_NoMessagesHint}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="4"
                            Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.IsEmpty), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8C3;" Style="{StaticResource EmptyStateIconStyle}" />
                            <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="{l:Str Key=Pane_NoMessagesTitle}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Column="1" Style="{StaticResource PaneDividerStyle}" />

                    <Grid
                        Grid.Column="2"
                        AutomationProperties.Name="{l:Str Key=Pane_Reader}"
                        Style="{StaticResource ReaderPaneStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <views:ReaderView x:Name="ReaderPane" Grid.RowSpan="2" />

                        <!-- Message en cours d'écriture (brouillon gardé et rouvert après une mise à jour compris). -->
                        <views:ComposerView
                            x:Name="ComposerPane"
                            Grid.RowSpan="2"
                            Visibility="{x:Bind ui:UiHelpers.VisibleIf(Composer.IsOpen), Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
