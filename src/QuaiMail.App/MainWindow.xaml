<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuaiMail.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:QuaiMail.App.Localization"
    xmlns:ui="using:QuaiMail.App"
    xmlns:views="using:QuaiMail.App.Views"
    xmlns:vm="using:QuaiMail.Core.ViewModels">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Invoked="OnSearchAccelerator" Modifiers="Control" />
            <KeyboardAccelerator Key="B" Invoked="OnTogglePaneAccelerator" Modifiers="Control" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (zone de glissement de la fenêtre). -->
        <Grid x:Name="AppTitleBar" Height="48">
            <StackPanel Style="{StaticResource TitleBarPanelStyle}">
                <Image Source="ms-appx:///Assets/AppIcon.png" Style="{StaticResource TitleBarIconStyle}" />
                <TextBlock Style="{StaticResource TitleBarTextStyle}" Text="{l:Str Key=App_Title}" />
            </StackPanel>
        </Grid>

        <!--
            Nouvelle version publiée sur GitHub (repris de Quai) : téléchargement, vérification, installation et
            redémarrage. Fermé, le bandeau est retiré de la mise en page.
        -->
        <StackPanel Grid.Row="1">
            <InfoBar
                IsOpen="{x:Bind Updates.IsOpen, Mode=TwoWay}"
                Message="{x:Bind Updates.Message, Mode=OneWay}"
                Severity="{x:Bind ui:UiHelpers.WarningIf(Updates.HasFailed), Mode=OneWay}"
                Style="{StaticResource UpdateInfoBarStyle}"
                Title="{l:Str Key=Update_Title}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Updates.IsOpen), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Click="OnUpdateActionClick"
                        Content="{x:Bind Updates.ActionText, Mode=OneWay}"
                        IsEnabled="{x:Bind Updates.IsActionEnabled, Mode=OneWay}" />
                </InfoBar.ActionButton>
                <ProgressBar
                    AutomationProperties.Name="{l:Str Key=Update_ProgressName}"
                    Maximum="100"
                    Style="{StaticResource UpdateProgressStyle}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(Updates.IsDownloading), Mode=OneWay}"
                    Value="{x:Bind Updates.Progress, Mode=OneWay}" />
            </InfoBar>

            <!-- Mail envoyé (seul le bouton Envoyer y mène). -->
            <InfoBar
                IsOpen="{x:Bind Composer.ShowSent, Mode=TwoWay}"
                Message="{x:Bind Composer.SentMessage, Mode=OneWay}"
                Severity="Success"
                Style="{StaticResource UpdateInfoBarStyle}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Composer.ShowSent), Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Volet 1 : comptes et dossiers. -->
            <Grid
                x:Name="NavPane"
                AutomationProperties.Name="{l:Str Key=Pane_Accounts}"
                Style="{StaticResource FolderPaneStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- En-tête : bouton « menu » (réduit le volet en rail d'icônes), titre et actualisation. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        AutomationProperties.Name="{x:Bind ui:UiHelpers.PaneToggleName(Mailbox.IsPaneCompact), Mode=OneWay}"
                        Command="{x:Bind Mailbox.TogglePaneCommand}"
                        Style="{StaticResource PaneToggleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ui:UiHelpers.PaneToggleName(Mailbox.IsPaneCompact), Mode=OneWay}">
                        <FontIcon Glyph="&#xE700;" Style="{StaticResource ButtonIconStyle}" />
                    </Button>
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource PaneTitleStyle}"
                        Text="{l:Str Key=Pane_Accounts}"
                        Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Mailbox.IsPaneCompact), Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="{l:Str Key=Mailbox_Refresh}"
                        Command="{x:Bind Mailbox.RefreshCommand}"
                        Style="{StaticResource PaneIconButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Mailbox_RefreshTooltip}"
                        Visibility="{x:Bind ui:UiHelpers.VisibleIfBoth(Mailbox.HasAccounts, Mailbox.IsPaneExpanded), Mode=OneWay}">
                        <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonIconStyle}" />
                    </Button>
                </Grid>

                <Button
                    Grid.Row="1"
                    AutomationProperties.Name="{l:Str Key=Toolbar_NewMessage}"
                    Click="OnNewMessageClick"
                    IsEnabled="{x:Bind Mailbox.HasAccounts, Mode=OneWay}"
                    Style="{StaticResource NewMessageButtonStyle}"
                    ToolTipService.ToolTip="{l:Str Key=Toolbar_NewMessageTooltip}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Style="{StaticResource ButtonContentStyle}">
                        <FontIcon Glyph="&#xE710;" Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock Text="{l:Str Key=Toolbar_NewMessage}" Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Mailbox.IsPaneCompact), Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <!-- Erreur de connexion : bandeau dans le volet déployé, icône avec info-bulle dans le rail. -->
                <InfoBar
                    Grid.Row="2"
                    IsOpen="{x:Bind Mailbox.HasError, Mode=OneWay}"
                    Message="{x:Bind Mailbox.ErrorMessage, Mode=OneWay}"
                    Severity="Warning"
                    Style="{StaticResource PaneInfoBarStyle}"
                    Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Mailbox.IsPaneCompact), Mode=OneWay}" />
                <FontIcon
                    Grid.Row="2"
                    AutomationProperties.Name="{l:Str Key=Mailbox_ErrorIconName}"
                    Glyph="&#xE7BA;"
                    Style="{StaticResource RailErrorIconStyle}"
                    ToolTipService.ToolTip="{x:Bind Mailbox.ErrorMessage, Mode=OneWay}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIfBoth(Mailbox.HasError, Mailbox.IsPaneCompact), Mode=OneWay}" />

                <ListView
                    x:Name="NavList"
                    Grid.Row="3"
                    AutomationProperties.Name="{l:Str Key=Pane_Accounts}"
                    ItemsSource="{x:Bind Mailbox.Items}"
                    PreviewKeyDown="OnNavPreviewKeyDown"
                    SelectionChanged="OnNavSelectionChanged"
                    Style="{StaticResource NavListStyle}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIfBoth(Mailbox.HasAccounts, Mailbox.IsPaneExpanded), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItemViewModel">
                            <Grid
                                AutomationProperties.Name="{x:Bind ui:UiHelpers.NavItemName(Title, IsAccount, IsExpanded, Unread), Mode=OneWay}"
                                Margin="{x:Bind ui:UiHelpers.Indent(Depth, IsAccount)}"
                                Style="{StaticResource NavItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="OnReconnectAccountClick"
                                            Text="{l:Str Key=Mailbox_Reconnect}"
                                            Visibility="{x:Bind ui:UiHelpers.VisibleIf(UsesBrowserSignIn)}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8D7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnRemoveAccountClick" Text="{l:Str Key=Mailbox_RemoveAccount}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <FontIcon
                                    Glyph="{x:Bind ui:UiHelpers.FolderGlyph(Role, IsAccount)}"
                                    Style="{StaticResource NavIconStyle}"
                                    Visibility="{x:Bind ui:UiHelpers.CollapsedIf(IsAccount)}" />
                                <!-- Ligne d'un compte : un clic (ou Entrée, Espace, flèches gauche / droite) replie ou déplie ses dossiers. -->
                                <FontIcon
                                    Glyph="{x:Bind ui:UiHelpers.ChevronGlyph(IsExpanded), Mode=OneWay}"
                                    Style="{StaticResource NavChevronStyle}"
                                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(IsAccount)}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontWeight="{x:Bind ui:UiHelpers.StrongIf(IsAccount)}"
                                    Style="{StaticResource NavTextStyle}"
                                    Text="{x:Bind Title}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource UnreadCountStyle}"
                                    Text="{x:Bind Unread, Mode=OneWay}"
                                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(HasUnread), Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    Rail d'icônes (volet réduit) : la boîte unifiée et chaque compte, sans leurs dossiers. Un clic (ou
                    Entrée) ouvre la boîte de réception du compte ; la surbrillance suit le dossier affiché.
                -->
                <ListView
                    x:Name="RailList"
                    Grid.Row="3"
                    AutomationProperties.Name="{l:Str Key=Pane_Accounts}"
                    ItemClick="OnRailItemClick"
                    ItemsSource="{x:Bind Mailbox.RailItems}"
                    SelectedItem="{x:Bind Mailbox.SelectedRailItem, Mode=OneWay}"
                    SelectionChanged="OnRailSelectionChanged"
                    Style="{StaticResource RailListStyle}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIfBoth(Mailbox.HasAccounts, Mailbox.IsPaneCompact), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItemViewModel">
                            <Grid
                                AutomationProperties.Name="{x:Bind ui:UiHelpers.RailItemName(Title, RailUnread), Mode=OneWay}"
                                Style="{StaticResource RailItemStyle}"
                                ToolTipService.ToolTip="{x:Bind ui:UiHelpers.RailItemName(Title, RailUnread), Mode=OneWay}">
                                <FontIcon
                                    Glyph="{x:Bind ui:UiHelpers.FolderGlyph(Role, IsAccount)}"
                                    Style="{StaticResource RailIconStyle}"
                                    Visibility="{x:Bind ui:UiHelpers.CollapsedIf(IsAccount)}" />
                                <PersonPicture
                                    DisplayName="{x:Bind Title}"
                                    Style="{StaticResource RailAvatarStyle}"
                                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(IsAccount)}" />
                                <InfoBadge
                                    Style="{StaticResource RailBadgeStyle}"
                                    Value="{x:Bind RailUnread, Mode=OneWay}"
                                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(HasRailUnread), Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="3"
                    Style="{StaticResource EmptyStatePanelStyle}"
                    Visibility="{x:Bind ui:UiHelpers.VisibleIfBoth(Mailbox.HasNoAccount, Mailbox.IsPaneExpanded), Mode=OneWay}">
                    <FontIcon Glyph="&#xE716;" Style="{StaticResource EmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="{l:Str Key=Pane_NoAccountTitle}" />
                    <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="{l:Str Key=Pane_NoAccountHint}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Style="{StaticResource PaneButtonsStyle}">
                    <Button
                        AutomationProperties.Name="{l:Str Key=Toolbar_AddAccount}"
                        Click="OnAddAccountClick"
                        Style="{StaticResource PaneButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Toolbar_AddAccount}">
                        <StackPanel Style="{StaticResource ButtonContentStyle}">
                            <FontIcon Glyph="&#xE710;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="{l:Str Key=Toolbar_AddAccount}" Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Mailbox.IsPaneCompact), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        AutomationProperties.Name="{l:Str Key=Toolbar_Settings}"
                        Click="OnSettingsClick"
                        Style="{StaticResource PaneButtonStyle}"
                        ToolTipService.ToolTip="{l:Str Key=Toolbar_SettingsTooltip}">
                        <StackPanel Style="{StaticResource ButtonContentStyle}">
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="{l:Str Key=Toolbar_Settings}" Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Mailbox.IsPaneCompact), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Volets 2 et 3 : liste des mails et lecture, sur une même surface. -->
            <Border Grid.Column="1" Style="{StaticResource ContentSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid AutomationProperties.Name="{l:Str Key=Pane_Messages}" Style="{StaticResource MessageListPaneStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Recherche plein texte (cache, sans connexion), puis éventuellement sur le serveur. -->
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            AutomationProperties.Name="{l:Str Key=Search_Placeholder}"
                            PlaceholderText="{l:Str Key=Search_Placeholder}"
                            QueryIcon="Find"
                            QuerySubmitted="OnSearchSubmitted"
                            Style="{StaticResource SearchBoxStyle}"
                            TextChanged="OnSearchTextChanged" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SurfaceHeaderStyle}" Text="{x:Bind Messages.Title, Mode=OneWay}" />
                            <HyperlinkButton
                                Grid.Column="1"
                                Command="{x:Bind Messages.SearchServerCommand}"
                                Content="{l:Str Key=Search_Server}"
                                Style="{StaticResource SearchServerLinkStyle}"
                                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.CanSearchServer), Mode=OneWay}" />
                            <!-- Filtre lu / non lu du dossier affiché (recherché sur le serveur). -->
                            <DropDownButton
                                x:Name="ReadFilterButton"
                                Grid.Column="2"
                                AutomationProperties.Name="{l:Str Key=Filter_Button}"
                                Style="{StaticResource ListFilterButtonStyle}"
                                ToolTipService.ToolTip="{l:Str Key=Filter_Button}"
                                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.CanFilter), Mode=OneWay}">
                                <StackPanel Style="{StaticResource ListFilterContentStyle}">
                                    <FontIcon Glyph="&#xE71C;" Style="{StaticResource ListFilterIconStyle}" />
                                    <TextBlock Text="{x:Bind Messages.FilterLabel, Mode=OneWay}" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <RadioMenuFlyoutItem
                                            Command="{x:Bind Messages.ShowAllMessagesCommand}"
                                            GroupName="ReadFilter"
                                            IsChecked="{x:Bind Messages.IsFilterAll, Mode=OneWay}"
                                            Text="{l:Str Key=Filter_All}" />
                                        <RadioMenuFlyoutItem
                                            Command="{x:Bind Messages.ShowUnreadOnlyCommand}"
                                            GroupName="ReadFilter"
                                            IsChecked="{x:Bind Messages.IsFilterUnread, Mode=OneWay}"
                                            Text="{l:Str Key=Filter_Unread}" />
                                        <RadioMenuFlyoutItem
                                            Command="{x:Bind Messages.ShowReadOnlyCommand}"
                                            GroupName="ReadFilter"
                                            IsChecked="{x:Bind Messages.IsFilterRead, Mode=OneWay}"
                                            Text="{l:Str Key=Filter_Read}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                        <ProgressBar
                            Grid.Row="2"
                            AutomationProperties.Name="{l:Str Key=Messages_Loading}"
                            Style="{StaticResource ListBusyBarStyle}"
                            Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.IsLoading), Mode=OneWay}" />
                        <InfoBar
                            Grid.Row="3"
                            IsOpen="{x:Bind Messages.HasError, Mode=OneWay}"
                            Message="{x:Bind Messages.ErrorMessage, Mode=OneWay}"
                            Severity="Warning"
                            Style="{StaticResource ListInfoBarStyle}" />

                        <ListView
                            x:Name="MessageList"
                            Grid.Row="4"
                            AutomationProperties.Name="{l:Str Key=Pane_Messages}"
                            ItemsSource="{x:Bind Messages.Messages}"
                            SelectedItem="{x:Bind Messages.SelectedMessage, Mode=OneWay}"
                            SelectionChanged="OnMessageSelectionChanged"
                            Style="{StaticResource MessageListStyle}">
                            <!-- Seulement quand le focus est dans la liste (voir MainWindow) : ailleurs, Ctrl+A et Suppr gardent leur rôle. -->
                            <ListView.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
                                <KeyboardAccelerator
                                    Key="A"
                                    Invoked="OnSelectAllAccelerator"
                                    Modifiers="Control" />
                            </ListView.KeyboardAccelerators>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageItemViewModel">
                                    <Grid AutomationProperties.Name="{x:Bind ui:UiHelpers.MessageName(Sender, Subject, DateText, IsRead), Mode=OneWay}" Style="{StaticResource MessageItemStyle}">
                                        <Grid.ContextFlyout>
                                            <!-- Vise toute la sélection si ce mail en fait partie (textes complétés à l'ouverture). -->
                                            <MenuFlyout Opening="OnMessageMenuOpening">
                                                <MenuFlyoutItem
                                                    Click="OnMarkReadClick"
                                                    Tag="MarkRead"
                                                    Text="{l:Str Key=Messages_MarkRead}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C3;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnMarkUnreadClick"
                                                    Tag="MarkUnread"
                                                    Text="{l:Str Key=Messages_MarkUnread}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE715;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSubItem Text="{l:Str Key=Messages_MoveTo}">
                                                    <MenuFlyoutSubItem.Icon>
                                                        <FontIcon Glyph="&#xE8DE;" />
                                                    </MenuFlyoutSubItem.Icon>
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutItem
                                                    Click="OnDeleteMessageClick"
                                                    KeyboardAcceleratorTextOverride="{l:Str Key=Messages_DeleteShortcut}"
                                                    Tag="Delete"
                                                    Text="{l:Str Key=Messages_Delete}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnSelectAllClick"
                                                    KeyboardAcceleratorTextOverride="{l:Str Key=Messages_SelectAllShortcut}"
                                                    Text="{l:Str Key=Messages_SelectAll}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8B3;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.RowSpan="2"
                                            Style="{x:Bind ui:UiHelpers.UnreadStyle(IsRead, 'MessageMarker'), Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{x:Bind ui:UiHelpers.UnreadStyle(IsRead, 'MessageSender'), Mode=OneWay}"
                                            Text="{x:Bind Sender}" />
                                        <StackPanel Grid.Column="2" Style="{StaticResource MessageMetaStyle}">
                                            <FontIcon
                                                Glyph="&#xE734;"
                                                Style="{StaticResource FlagIconStyle}"
                                                Visibility="{x:Bind ui:UiHelpers.VisibleIf(IsFlagged), Mode=OneWay}" />
                                            <TextBlock Style="{x:Bind ui:UiHelpers.UnreadStyle(IsRead, 'MessageDate'), Mode=OneWay}" Text="{x:Bind DateText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Style="{x:Bind ui:UiHelpers.UnreadStyle(IsRead, 'MessageSubject'), Mode=OneWay}"
                                            Text="{x:Bind Subject}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.Footer>
                                <Button
                                    Command="{x:Bind Messages.LoadMoreCommand}"
                                    Content="{l:Str Key=Messages_LoadMore}"
                                    Style="{StaticResource LoadMoreButtonStyle}"
                                    Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.HasMore), Mode=OneWay}" />
                            </ListView.Footer>
                        </ListView>

                        <StackPanel
                            Grid.Row="4"
                            Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Messages.HasFolder), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8C3;" Style="{StaticResource EmptyStateIconStyle}" />
                            <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="{l:Str Key=Pane_NoFolderTitle}" />
                            <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="{l:Str Key=Pane_NoMessagesHint}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="4"
                            Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind ui:UiHelpers.VisibleIf(Messages.IsEmpty), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8C3;" Style="{StaticResource EmptyStateIconStyle}" />
                            <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="{x:Bind Messages.EmptyTitle, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Column="1" Style="{StaticResource PaneDividerStyle}" />

                    <Grid
                        Grid.Column="2"
                        AutomationProperties.Name="{l:Str Key=Pane_Reader}"
                        Style="{StaticResource ReaderPaneStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <views:ReaderView x:Name="ReaderPane" Grid.RowSpan="2" />

                        <!-- Message en cours d'écriture (brouillon gardé et rouvert après une mise à jour compris). -->
                        <views:ComposerView
                            x:Name="ComposerPane"
                            Grid.RowSpan="2"
                            Visibility="{x:Bind ui:UiHelpers.VisibleIf(Composer.IsOpen), Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
