<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="QuaiMail.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:QuaiMail.App.Localization"
    xmlns:ui="using:QuaiMail.App"
    xmlns:vm="using:QuaiMail.Core.ViewModels"
    Title="{l:Str Key=Settings_Title}"
    CloseButtonText="{l:Str Key=Common_Close}"
    DefaultButton="Close">

    <ScrollViewer Style="{StaticResource DialogScrollStyle}">
        <StackPanel Style="{StaticResource DialogFormStyle}">
            <RadioButtons Header="{l:Str Key=Settings_Theme}" SelectedIndex="{x:Bind Settings.ThemeIndex, Mode=TwoWay}">
                <RadioButton Content="{l:Str Key=Settings_ThemeSystem}" />
                <RadioButton Content="{l:Str Key=Settings_ThemeLight}" />
                <RadioButton Content="{l:Str Key=Settings_ThemeDark}" />
            </RadioButtons>
            <StackPanel>
                <ToggleSwitch Header="{l:Str Key=Settings_RemoteImages}" IsOn="{x:Bind Settings.BlockRemoteImages, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Settings_RemoteImagesDescription}" />
            </StackPanel>
            <StackPanel>
                <ToggleSwitch Header="{l:Str Key=Settings_Notifications}" IsOn="{x:Bind Settings.ShowNotifications, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Settings_NotificationsDescription}" />
            </StackPanel>
            <StackPanel>
                <ToggleSwitch Header="{l:Str Key=Settings_UnreadBadge}" IsOn="{x:Bind Settings.ShowUnreadBadge, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Settings_UnreadBadgeDescription}" />
            </StackPanel>
            <!-- Agent de notification : nouveaux mails annoncés quand Quai Mail est fermé (icône dans les icônes cachées). -->
            <StackPanel Visibility="{x:Bind ui:UiHelpers.VisibleIf(Settings.AgentAvailable)}">
                <ToggleSwitch
                    Header="{l:Str Key=Settings_Agent}"
                    IsEnabled="{x:Bind Settings.ShowNotifications, Mode=OneWay}"
                    IsOn="{x:Bind Settings.BackgroundAgent, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Settings_AgentDescription}" />
                <CheckBox
                    Content="{l:Str Key=Settings_AgentAutoStart}"
                    IsChecked="{x:Bind Settings.AgentAutoStart, Mode=TwoWay}"
                    IsEnabled="{x:Bind ui:UiHelpers.Both(Settings.ShowNotifications, Settings.BackgroundAgent), Mode=OneWay}" />
            </StackPanel>
            <StackPanel>
                <ToggleSwitch Header="{l:Str Key=Settings_Updates}" IsOn="{x:Bind Settings.CheckForUpdates, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Settings_UpdatesDescription}" />
            </StackPanel>
            <StackPanel>
                <ToggleSwitch Header="{l:Str Key=Settings_LookUpKeys}" IsOn="{x:Bind Settings.LookUpPgpKeys, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Settings_LookUpKeysDescription}" />
            </StackPanel>
            <StackPanel>
                <Button Click="OnClearCacheClick" Content="{l:Str Key=Settings_ClearCache}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Settings_ClearCacheDescription}" />
            </StackPanel>

            <!-- Expéditeurs sûrs : ajoutés depuis la lecture d'un mail (« Faire confiance »), retirés ici. -->
            <StackPanel Style="{StaticResource PgpSectionStyle}">
                <TextBlock Style="{StaticResource DialogSectionStyle}" Text="{l:Str Key=Trusted_Section}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Trusted_Intro}" />
                <TextBlock
                    Style="{StaticResource DialogHintStyle}"
                    Text="{l:Str Key=Trusted_None}"
                    Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Trusted.HasItems), Mode=OneWay}" />
                <ItemsRepeater x:Name="TrustedRepeater" ItemsSource="{x:Bind Trusted.Items}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrustedSenderItem">
                            <Grid Style="{StaticResource TrustedRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TrustedNameStyle}" Text="{x:Bind Label}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="{x:Bind RemoveName}"
                                    Click="OnRemoveTrustedClick"
                                    Style="{StaticResource ReaderActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind RemoveName}">
                                    <FontIcon Glyph="&#xE711;" Style="{StaticResource ButtonIconStyle}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Signature des mails : clés secrètes importées de GnuPG ou de Kleopatra. -->
            <StackPanel Style="{StaticResource PgpSectionStyle}">
                <TextBlock Style="{StaticResource DialogSectionStyle}" Text="{l:Str Key=Pgp_Section}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Pgp_Intro}" />
                <TextBlock
                    Style="{StaticResource DialogHintStyle}"
                    Text="{l:Str Key=Pgp_NoKey}"
                    Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Keys.HasKeys), Mode=OneWay}" />
                <ItemsRepeater x:Name="KeysRepeater" ItemsSource="{x:Bind Keys.Keys}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PgpKeyItem">
                            <Grid Style="{StaticResource PgpKeyRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PgpKeyNameStyle}" Text="{x:Bind UserId}" />
                                    <TextBlock Style="{StaticResource PgpFingerprintStyle}" Text="{x:Bind Fingerprint}" />
                                    <TextBlock Style="{StaticResource DialogHintStyle}" Text="{x:Bind Details}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="{l:Str Key=Pgp_Remove}"
                                    Style="{StaticResource ReaderActionButtonStyle}"
                                    ToolTipService.ToolTip="{l:Str Key=Pgp_Remove}">
                                    <FontIcon Glyph="&#xE74D;" Style="{StaticResource ButtonIconStyle}" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Style="{StaticResource PgpConfirmStyle}">
                                                <TextBlock Style="{StaticResource DialogBodyStyle}" Text="{x:Bind RemoveMessage}" />
                                                <Button
                                                    Click="OnRemoveKeyConfirmed"
                                                    Content="{l:Str Key=Pgp_RemoveConfirm}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Tag="{x:Bind Key}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <!--
                    GnuPG (Kleopatra) installé : ses clés de signature, listées à chaque ouverture des Réglages. « Importer »
                    copie la clé dans Quai Mail (elle y reste) ; la phrase de passe se tape dans le petit menu du bouton.
                -->
                <StackPanel Style="{StaticResource PgpSectionStyle}" Visibility="{x:Bind ui:UiHelpers.VisibleIf(Keys.HasGnuPg), Mode=OneWay}">
                    <TextBlock Style="{StaticResource PgpKeyNameStyle}" Text="{x:Bind Keys.GnuPgTitle, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Pgp_GnuPgHint}" />
                    <TextBlock
                        Style="{StaticResource DialogHintStyle}"
                        Text="{l:Str Key=Pgp_GnuPgNone}"
                        Visibility="{x:Bind ui:UiHelpers.CollapsedIf(Keys.HasGnuPgKeys), Mode=OneWay}" />
                    <ItemsRepeater x:Name="GnuPgRepeater" ItemsSource="{x:Bind Keys.GnuPgKeys}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:GnuPgKeyItem">
                                <Grid Style="{StaticResource PgpKeyRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PgpKeyNameStyle}" Text="{x:Bind UserId}" />
                                        <TextBlock Style="{StaticResource PgpFingerprintStyle}" Text="{x:Bind Fingerprint}" />
                                        <TextBlock Style="{StaticResource DialogHintStyle}" Text="{x:Bind Status}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="{x:Bind ActionText}"
                                        Visibility="{x:Bind ui:UiHelpers.VisibleIf(CanImport)}">
                                        <Button.Flyout>
                                            <Flyout Opening="OnGnuPgFlyoutOpening">
                                                <StackPanel Style="{StaticResource PgpConfirmStyle}">
                                                    <TextBlock Style="{StaticResource DialogBodyStyle}" Text="{x:Bind PassphrasePrompt}" />
                                                    <PasswordBox
                                                        AutomationProperties.Name="{l:Str Key=Passphrase_Label}"
                                                        KeyDown="OnGnuPgPassphraseKeyDown"
                                                        PlaceholderText="{l:Str Key=Passphrase_Label}" />
                                                    <Button
                                                        Click="OnImportFromGnuPgConfirmed"
                                                        Content="{x:Bind ActionText}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Tag="{x:Bind}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <StackPanel Style="{StaticResource PgpButtonsStyle}">
                    <Button Click="OnImportKeyClick" Content="{l:Str Key=Pgp_Import}" />
                    <Button Click="OnForgetPassphrasesClick" Content="{l:Str Key=Pgp_Forget}" />
                </StackPanel>
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind Keys.HasMessage, Mode=OneWay}"
                    Message="{x:Bind Keys.Message, Mode=OneWay}"
                    Severity="{x:Bind ui:UiHelpers.ErrorIf(Keys.IsError), Mode=OneWay}" />
                <TextBlock Style="{StaticResource DialogHintStyle}" Text="{l:Str Key=Pgp_HowTo}" />
            </StackPanel>

            <TextBlock Style="{StaticResource DialogHintStyle}" Text="{x:Bind ui:UiHelpers.VersionText(Settings.Version)}" />
            <TextBlock Style="{StaticResource DialogHintStyle}" Text="{x:Bind Settings.DataDirectory}" />
            <HyperlinkButton Click="OnOpenLogsClick" Content="{l:Str Key=Settings_OpenLogs}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
